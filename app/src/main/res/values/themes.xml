<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        The layout paints its own light palette, so following the system into night mode left
        dark dialogs sitting on a light page. Pinned to light until the palette has a dark
        counterpart to switch to.
    -->
    <style name="Theme.R99Companion" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/forest</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/paper</item>
    </style>
</resources>
