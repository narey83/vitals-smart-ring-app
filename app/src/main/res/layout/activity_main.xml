<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R99 Companion"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your ring data, stored on your phone."
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <!-- Live readings, filled in as the ring reports them -->
        <LinearLayout
            android:id="@+id/readings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/mint"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Live readings"
                android:textColor="@color/forest"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/valueHeart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Heart rate — no reading yet"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/valueOxygen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blood oxygen — no reading yet"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/valuePressure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blood pressure — no reading yet"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/valueSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Steps — no reading yet"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/valueBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Battery — no reading yet"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Connect straight to my ring" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Find a ring by scanning" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Ready. Keep the ring charged and close by."
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Take a measurement"
            android:textColor="@color/forest"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/heartButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Heart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/oxygenButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="SpO2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pressureButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Pressure" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Ring settings"
            android:textColor="@color/forest"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/monitorButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Automatic monitoring: off" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/photoButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Shutter mode: off" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/timeButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Set the ring's clock to this phone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/readAllButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Read everything from the ring" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Send a raw command"
            android:textColor="@color/forest"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/commandInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:fontFamily="monospace"
                android:hint="group cmd payload, e.g. 020C"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:textColor="@color/ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="8dp"
                android:text="Send" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/frameCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Wrap as a ring frame (adds length and CRC)"
            android:textColor="@color/ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Bluetooth protocol log"
            android:textColor="@color/forest"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="6dp"
            android:background="@color/mint"
            android:padding="10dp">

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/ink"
                android:textSize="12sp" />
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="Share protocol log" />
    </LinearLayout>
</ScrollView>
